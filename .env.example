# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.

# Shopify Storefront API (Shopify Admin → Settings → Apps → Develop apps → Storefront API)
# NOTE: this must be a *Storefront* access token (public), NOT an Admin token (shpat_...).
VITE_SHOPIFY_STORE_DOMAIN="yourstore.myshopify.com"
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token"

# Storefront API version (YYYY-MM). Shopify supports each version for 12 months.
VITE_SHOPIFY_API_VERSION="2025-07"
